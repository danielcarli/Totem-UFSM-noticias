{
  "name": "destaques-ufsm",
  "productName": "Destaques UFSM",
  "version": "1.4.4",
  "description": "Painel de notícias da UFSM em tela cheia — todas as notícias com foto da página principal",
  "main": "main.js",
  "author": {
    "name": "Coordenadoria de Comunicação UFSM",
    "email": "comunicacao@ufsm.br"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "painel": "node scripts/construir-painel.mjs",
    "dist": "npm run painel && electron-builder --win --linux --publish never",
    "dist:win": "npm run painel && electron-builder --win --publish never",
    "dist:linux": "npm run painel && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "qrcode-generator": "1.4.4"
  },
  "homepage": "https://github.com/danielcarli/Totem-UFSM-noticias",
  "build": {
    "appId": "br.ufsm.destaques",
    "productName": "Destaques UFSM",
    "copyright": "UFSM — Coordenadoria de Comunicação",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "LEIA-ME.txt",
        "to": "LEIA-ME.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icone.ico",
      "executableName": "DestaquesUFSM",
      "legalTrademarks": "UFSM",
      "artifactName": "Destaques-UFSM-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Destaques UFSM",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "Destaques UFSM — painel de notícias",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "license": "build/LICENCA.txt",
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "UFSM",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Destaques-UFSM-Setup.${ext}",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icons",
      "executableName": "destaques-ufsm",
      "synopsis": "Painel de notícias da UFSM em tela cheia",
      "description": "Mostra as notícias com foto da página principal da UFSM em um carrossel para TVs e totens, na horizontal ou na vertical. Atualiza sozinho a cada 15 minutos. Agência de Notícias / Coordenadoria de Comunicação UFSM.",
      "vendor": "UFSM — Coordenadoria de Comunicação",
      "maintainer": "UFSM - Coordenadoria de Comunicação <comunicacao@ufsm.br>",
      "desktop": {
        "entry": {
          "Name": "Destaques UFSM",
          "GenericName": "Painel de notícias",
          "Comment": "Painel de notícias da UFSM em tela cheia",
          "Keywords": "ufsm;notícias;painel;tv;totem;",
          "StartupWMClass": "Destaques UFSM"
        }
      },
      "artifactName": "Destaques-UFSM-linux-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnss3",
        "libasound2 | libasound2t64",
        "libgbm1",
        "libdrm2",
        "libxkbcommon0",
        "libxcomposite1",
        "libxdamage1",
        "libxrandr2",
        "libxfixes3",
        "libxext6",
        "libx11-6",
        "libxcb1",
        "libcairo2",
        "libpango-1.0-0",
        "libexpat1",
        "libdbus-1-3",
        "libatk1.0-0 | libatk1.0-0t64",
        "libatk-bridge2.0-0 | libatk-bridge2.0-0t64",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libcups2 | libcups2t64",
        "libglib2.0-0 | libglib2.0-0t64",
        "libnspr4",
        "libudev1",
        "xdg-utils"
      ],
      "artifactName": "destaques-ufsm_amd64.${ext}"
    },
    "rpm": {
      "artifactName": "destaques-ufsm.x86_64.${ext}"
    },
    "appImage": {
      "artifactName": "Destaques-UFSM-x86_64.${ext}"
    }
  },
  "desktopName": "destaques-ufsm.desktop",
  "contributors": [
    "Daniel Michelon De Carli (idealizador)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/danielcarli/Totem-UFSM-noticias.git"
  },
  "bugs": {
    "url": "https://github.com/danielcarli/Totem-UFSM-noticias/issues"
  }
}
