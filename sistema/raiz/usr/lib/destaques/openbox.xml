<?xml version="1.0" encoding="UTF-8"?>
<!-- Destaques UFSM – Sistema: gerenciador de janelas mínimo, sem bordas nem menus. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <placement><policy>Smart</policy></placement>
  <desktops><number>1</number></desktops>
  <theme><name>Clearlooks</name><titleLayout></titleLayout></theme>
  <keyboard>
    <!-- sem atalhos do openbox: as teclas ficam com o painel -->
  </keyboard>
  <mouse><dragThreshold>8</dragThreshold></mouse>
  <menu></menu>
  <applications>
    <application class="*">
      <decor>no</decor>
    </application>
  </applications>
</openbox_config>
