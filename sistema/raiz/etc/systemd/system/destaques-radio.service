[Unit]
Description=Destaques UFSM: liga o radio do Wi-Fi e acerta o driver de placas Broadcom
After=systemd-rfkill.service systemd-udevd.service systemd-modules-load.service

[Service]
Type=oneshot
ExecStart=-/usr/sbin/rfkill unblock wifi
ExecStart=-/usr/lib/destaques/wifi-broadcom

[Install]
WantedBy=multi-user.target
